#!/usr/bin/perl
print<<HEADER;
############################################################
#
# mUPnP for C
#
# Copyright (C) Satoshi Konno 2005
#
############################################################

TESTS = mupnptest device-start-no-interfaces.sh
check_PROGRAMS = mupnptest
EXTRA_DIST = device-start-no-interfaces.sh
TESTS_ENVIRONMENT = CC="\$(CC)" XML_LIBS="\@XML_LIBS\@" CODE_COVERAGE_LIBS="\$(CODE_COVERAGE_LIBS)"

AM_CPPFLAGS = -I\$(top_srcdir)/include -I../ \$(CODE_COVERAGE_CPPFLAGS)
AM_CFLAGS = \$(CODE_COVERAGE_CFLAGS)
AM_CXXFLAGS = \$(CODE_COVERAGE_CXXFLAGS)

HEADER

print<<NOINST_HEADERS;
noinst_HEADERS = \\
NOINST_HEADERS

my @find_files = `find ../ -path '../espidf' -prune -o -name '*.h' -print`;
my @include_files;
foreach $file (@find_files) {
	$file =~ s/\n//;
	$file = "\t" . $file;
	push @include_files, $file;
}
print join(" \\\n", @include_files) . "\n";

print<<SOURCES;

mupnptest_SOURCES = \\
SOURCES

my @find_files = `find ../ -path '../espidf' -prune -o -name '*.cpp' -print -o -name '*.c' -print`;
my @source_files;
foreach $file (@find_files) {
	$file =~ s/\n//;
	$file = "\t" . $file;
	push @source_files, $file;
}
print join(" \\\n", @source_files) . "\n";

print<<FOTTER;
mupnptest_LDADD = ../../lib/unix/libmupnp.a \@XML_LIBS\@ \$(CODE_COVERAGE_LIBS)
FOTTER

