#!/usr/bin/perl
use strict;
use warnings;

print <<'HEADER';
cmake_minimum_required(VERSION 3.5)

# Keep a single source list for the host library and ESP-IDF component.
set(MUPNP_SRCS
HEADER

my @source_files = `find src/mupnp -name '*.c' | sort`;
foreach my $file (@source_files) {
  chomp($file);
  print "  $file\n";
}

print <<'FOOTER';
  )

# ESP-IDF evaluates components before its top-level project() call. Do not run
# the standalone host build or dependency discovery in this branch.
if(ESP_PLATFORM)
  idf_component_register(
    SRCS ${MUPNP_SRCS}
    INCLUDE_DIRS include
    REQUIRES esp_netif lwip pthread esp_timer esp_hw_support
    PRIV_REQUIRES espressif__expat)
  target_compile_definitions(${COMPONENT_LIB} PUBLIC
    MUPNP_XMLPARSER_EXPAT
    HAVE_STDINT_H
    HAVE_GMTIME_R
    HAVE_SNPRINTF)
  foreach(required_config CONFIG_LWIP_IPV4 CONFIG_LWIP_SO_REUSE CONFIG_VFS_SUPPORT_SELECT)
    if(NOT ${required_config})
      message(FATAL_ERROR "mUPnP requires ${required_config}=y; see doc/espidf.md")
    endif()
  endforeach()
  if(NOT CONFIG_LWIP_SO_REUSE_RXTOALL)
    message(WARNING "Enable CONFIG_LWIP_SO_REUSE_RXTOALL when using multiple SSDP listeners")
  endif()
  return()
endif()

project(mUPnP LANGUAGES C)

#
# Build options
#

option(CG_HTTP_CURL "Enable Libcurl support" OFF)
option(CG_HTTP_USE_PERSISTENT_CONNECTIONS
  "Enable persistent connections support" ON)
option(CG_NET_USE_ANYADDR
  "Enables the usage of IPV4_ADDRANY instead of registering an explicit server for each interface" ON)
option(CG_OPTIMIZED_CP_MODE "Enable optimized control point mode" OFF)
option(CG_USE_CFILE "Enable file functions" OFF)
option(CG_USE_OPENSSL "Enable OpenSSL support" OFF)
option(CG_XMLPARSER_LIBXML2 "Use Libxml2 instead of Expat for XML parsing" OFF)

foreach(OPT
    CG_HTTP_CURL CG_HTTP_USE_PERSISTENT_CONNECTIONS CG_NET_USE_ANYADDR
    CG_OPTIMIZED_CP_MODE CG_USE_CFILE CG_USE_OPENSSL CG_XMLPARSER_LIBXML2)
  if(${OPT})
    add_definitions(-D${OPT})
  endif(${OPT})
endforeach()

#
# Compiler related
#

if(MSVC)
  set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} /MP")
endif(MSVC)

#
# Host library target
#

include_directories(include)
add_library(MUPNP STATIC ${MUPNP_SRCS})

#
# Optional subdirectories
#

option(MUPNP_ENABLE_EXAMPLES "Build examples" ON)
option(MUPNP_ENABLE_TEST "Build tests" OFF)

if(MUPNP_ENABLE_EXAMPLES)
  add_subdirectory(examples)
endif()

if(MUPNP_ENABLE_TEST)
  enable_testing()
  add_subdirectory(test)
endif()

#
# Dependencies
#

if(NOT WIN32)
  find_library(LIBUUID_LIBRARY uuid)
  find_path(LIBUUID_INCLUDE_DIR uuid/uuid.h)
  if(LIBUUID_LIBRARY AND LIBUUID_INCLUDE_DIR)
    # TODO: try_compile() for HAVE_UUID_UNPARSE_LOWER
    add_definitions(
      -DHAVE_LIBUUID
      -DHAVE_UUID_UNPARSE_LOWER
      -DHAVE_UUID_UUID_H
      )
    include_directories(${LIBUUID_INCLUDE_DIR})
    target_link_libraries(MUPNP PUBLIC ${LIBUUID_LIBRARY})
    message(STATUS "Found libuuid: ${LIBUUID_LIBRARY}")
  else()
    message(WARNING "libuuid not found. Install uuid-dev package for UUID support.")
  endif()
endif(NOT WIN32)

if(CG_HTTP_CURL)
  find_package(CURL REQUIRED)
  include_directories(${CURL_INCLUDE_DIRS})
  target_link_libraries(MUPNP PUBLIC ${CURL_LIBRARIES})
endif(CG_HTTP_CURL)

if(CG_USE_OPENSSL)
  find_package(OpenSSL REQUIRED)
  include_directories(${OPENSSL_INCLUDE_DIR})
  target_link_libraries(MUPNP PUBLIC ${OPENSSL_LIBRARIES})
endif(CG_USE_OPENSSL)

if(CG_XMLPARSER_LIBXML2)
  find_package(LibXml2 REQUIRED)
  add_definitions(${LIBXML2_DEFINITIONS})
  include_directories(${LIBXML2_INCLUDE_DIR})
  target_link_libraries(MUPNP PUBLIC ${LIBXML2_LIBRARIES})
else(CG_XMLPARSER_LIBXML2)
  find_library(LIBEXPAT_LIBRARY expat)
  find_path(LIBEXPAT_INCLUDE_DIR expat.h PATH_SUFFIXES expat)
  include_directories(${LIBEXPAT_INCLUDE_DIR})
  target_link_libraries(MUPNP PUBLIC ${LIBEXPAT_LIBRARY})
  if(APPLE)
    find_package(LibXml2)
    if(LIBXML2_FOUND)
      include_directories(${LIBXML2_INCLUDE_DIR})
      target_link_libraries(MUPNP PUBLIC ${LIBXML2_LIBRARIES})
    endif()
  endif()
endif(CG_XMLPARSER_LIBXML2)

#
# Installation
#

install(DIRECTORY include/mupnp/ DESTINATION include/cybergarage
  FILES_MATCHING PATTERN "*.h")
install(TARGETS MUPNP ARCHIVE DESTINATION lib LIBRARY DESTINATION lib
  RUNTIME DESTINATION bin)
FOOTER
